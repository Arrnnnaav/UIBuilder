# Every key is optional. Missing keys disable the feature; the site still builds and runs.

# Contact form email (Resend free tier: 3k/month)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Site <hello@yourdomain.com>"

# Cloudflare Turnstile (free). Test keys that always pass:
#   site 1x00000000000000000000AA  secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# PostHog (cookieless) — free tier
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry — free developer tier
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

RATE_LIMIT_PER_MINUTE=5
# Local only: cap build workers when memory is tight
# NEXT_BUILD_CPUS=2
