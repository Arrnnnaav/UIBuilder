    "dev": "next dev",
    "prebuild": "node scripts/gen-content-index.mjs && node scripts/validate-content.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "node scripts/gen-content-index.mjs && next typegen && tsc --noEmit",
    "lint": "eslint",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seo:audit": "node scripts/seo-audit.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:tokens && pnpm test && pnpm build && pnpm test:e2e && pnpm seo:audit",
    "perf": "node scripts/perf.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/nextjs": "^11.0.0",
    "motion": "^13.4.2",
    "next": "16.3.6",
    "posthog-js": "^1.434.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.28.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/react": "7.0.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "astro": "7.3.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "lighthouse": "^13.5.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  }
