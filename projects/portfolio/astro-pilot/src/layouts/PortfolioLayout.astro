---
import "../styles/portfolio.css";
import { site, routes } from "@/lib/site";
import { globalJsonLd } from "@/lib/seo";

interface Props {
  route: string;
}

const { route } = Astro.props;
const page = routes[route];
if (!page) throw new Error(`Missing SEO route: ${route}`);
const title = page.title;
const description = page.description;
const canonical = page.canonical === "/" ? new URL(site.url).origin : new URL(page.canonical, site.url).toString();
const globalSchemas = globalJsonLd();
const socialImage = new URL(page.og?.image ?? "/opengraph-image", site.url).toString();
---

<!doctype html>
<html lang="en" class="portfolio-static">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <meta name="robots" content={page.robots.replace(",", ", ")} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={page.og?.title ?? title} />
    <meta property="og:description" content={page.og?.description ?? description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={page.og?.title ?? title} />
    <meta name="twitter:description" content={page.og?.description ?? description} />
    <meta name="twitter:image" content={socialImage} />
    {globalSchemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll("<", "\\u003c")} />)}
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header">
      <div class="container nav-bar">
        <a href="/" class="wordmark">Arnav Khandelwal</a>
        <nav class="desktop-nav" aria-label="Primary">
          <a href="/work" aria-current={route.startsWith("/work") ? "page" : undefined}>Work</a><a href="/about" aria-current={route === "/about" ? "page" : undefined}>About</a>
          <a href="https://github.com/Arrnnnaav" target="_blank" rel="me noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </nav>
        <a class="button nav-contact" href="/contact" aria-current={route === "/contact" ? "page" : undefined}>Contact Arnav</a>
        <button type="button" class="menu-button" aria-haspopup="dialog" data-menu-trigger>Menu</button>
      </div>
      <dialog class="nav-dialog" aria-label="Main menu" data-nav-dialog>
        <div class="container">
          <button type="button" class="menu-close text-link" data-menu-close>Close menu</button>
          <nav aria-label="Mobile primary">
            <a href="/work" aria-current={route.startsWith("/work") ? "page" : undefined}>Work</a>
            <a href="/about" aria-current={route === "/about" ? "page" : undefined}>About</a>
            <a href="https://github.com/Arrnnnaav" target="_blank" rel="me noopener noreferrer">GitHub <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
            <a href="/contact">Contact Arnav</a>
            <a href="/resume">Résumé</a>
          </nav>
        </div>
      </dialog>
    </header>
    <main id="main" tabindex="-1" class="container flex-1"><slot /></main>
    <footer class="container site-footer">
      <a class="footer-cta" href={route === "/contact" ? "/work" : "/contact"}>{route === "/contact" ? "See the work" : "Contact Arnav"}</a>
      <div class="footer-columns">
        <div><h2>Site</h2><nav aria-label="Footer"><a href="/">Home</a><a href="/work">Work</a><a href="/about">About</a><a href="/contact">Contact</a><a href="/resume">Résumé</a></nav></div>
        <div><h2>Case studies</h2><a href="/work/edge-node">Edge Node</a><a href="/work/cited-researcher">Cited Researcher</a><a href="/work/ledgerbridge">LedgerBridge</a><a href="/work/ghostcursor">GhostCursor</a><a href="/work/neuroux">NeuroUX</a><a href="/work/studyos">StudyOS</a></div>
        <div><h2>Profiles</h2><a href="https://github.com/Arrnnnaav" rel="me">GitHub</a></div>
      </div>
      <div class="footer-note"><a href="/#evidence">Numbers on this site link to their sources.</a><p>© 2026 Arnav Khandelwal</p></div>
    </footer>
  </body>
</html>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-nav-dialog]");
  const trigger = document.querySelector<HTMLButtonElement>("[data-menu-trigger]");
  const closeButton = dialog?.querySelector<HTMLButtonElement>("[data-menu-close]");

  const closeDialog = () => {
    if (dialog?.open) dialog.close();
    document.body.style.overflow = "";
    trigger?.focus();
  };

  if (dialog && trigger) {
    trigger.addEventListener("click", () => {
      dialog.showModal();
      document.body.style.overflow = "hidden";
    });
    closeButton?.addEventListener("click", closeDialog);
    dialog.addEventListener("close", () => {
      document.body.style.overflow = "";
      trigger.focus();
    });
    dialog.addEventListener("cancel", event => {
      event.preventDefault();
      closeDialog();
    });
    dialog.addEventListener("click", event => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const link = target.closest("a[href]");
      if (link && link.getAttribute("href")?.startsWith("/")) closeDialog();
    });
    dialog.addEventListener("keydown", event => {
      if (event.key !== "Tab") return;
      const items = [...dialog.querySelectorAll<HTMLElement>('a[href],button:not([disabled]),[tabindex="0"]')]
        .filter(item => item.getClientRects().length > 0);
      const first = items[0];
      const last = items.at(-1);
      if (!first || !last) return;
      const index = items.indexOf(document.activeElement as HTMLElement);
      const next = index < 0
        ? (event.shiftKey ? items.length - 1 : 0)
        : (index + (event.shiftKey ? -1 : 1) + items.length) % items.length;
      event.preventDefault();
      items[next].focus();
    });
  }

  document.querySelectorAll<HTMLElement>(".work-dock").forEach(dock => {
    const preview = dock.querySelector<HTMLElement>(".work-preview");
    if (!preview) return;

    const activate = (event: Event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const row = target.closest<HTMLElement>("[data-work-row]");
      if (!row || !dock.contains(row)) return;
      preview.style.transform = `translateY(${row.offsetTop}px)`;
      preview.querySelectorAll<HTMLElement>("[data-preview]").forEach(item => {
        item.dataset.active = String(item.dataset.preview === row.dataset.workRow);
      });
    };

    dock.addEventListener("pointerover", activate);
    dock.addEventListener("focusin", activate);
  });

  if (!matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) {
        if (!entry.isIntersecting || entry.intersectionRatio < 0.5) continue;
        const row = entry.target as HTMLElement;
        requestAnimationFrame(() => requestAnimationFrame(() => row.removeAttribute("data-armed")));
        observer.unobserve(row);
      }
    }, { threshold: 0.5 });
    document.querySelectorAll<HTMLElement>("[data-retract]").forEach(row => {
      row.setAttribute("data-armed", "");
      observer.observe(row);
    });
  }
</script>
