---
import { clientEnv } from "@/lib/env";
import { portfolio } from "@/lib/portfolio";
import { Faq } from "@/components/seo/Faq";
import { Intro } from "@/components/portfolio/Intro";
import { PageSchema } from "@/components/portfolio/PageSchema";
import { ProfileLinks } from "@/components/portfolio/ProfileLinks";
import ContactForm from "../components/ContactForm.astro";
import PortfolioLayout from "../layouts/PortfolioLayout.astro";
---

<PortfolioLayout route="/contact">
  <Intro title={`Contact ${portfolio.name}`}>
    <p>Write about backend and AI roles, internships, collaborations or a build you have in mind.</p>
  </Intro>
  <div class="contact-grid">
    <ContactForm turnstileSiteKey={clientEnv.NEXT_PUBLIC_TURNSTILE_SITE_KEY} github={portfolio.github} />
    <aside>
      <h2>Direct channels</h2>
      <p class="caption">Prefer a direct conversation? Use a profile or email.</p>
      <ProfileLinks />
    </aside>
  </div>
  <div class="page-section"><Faq route="/contact" /></div>
  <PageSchema route="/contact" />
</PortfolioLayout>
