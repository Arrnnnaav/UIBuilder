---
import CaseStudy from "@/app/work/[slug]/page";
import { portfolio } from "@/lib/portfolio";
import PortfolioLayout from "../../layouts/PortfolioLayout.astro";

export function getStaticPaths() {
  return portfolio.projects.map(project => ({ params: { slug: project.slug } }));
}

const { slug } = Astro.params;
if (!slug) throw new Error("A project slug is required.");
---

<PortfolioLayout route={`/work/${slug}`}>
  <CaseStudy params={Promise.resolve({ slug })} />
</PortfolioLayout>
